@model SqlInjectionLabApp.Models.EfDemoViewModel
@{
    ViewData["Title"] = "EF - FromSqlInterpolated (SECURISE)";
}

<div class="row justify-content-center">
    <div class="col-md-11">
        <div class="alert alert-success d-flex align-items-center">
            <strong class="me-2">SECURISE</strong>
            <span>Utilise <code>FromSqlInterpolated($"... {input} ...")</code> : EF convertit l'interpolation C# en parametres SQL.</span>
        </div>

        <h2>Recherche via Entity Framework - FromSqlInterpolated</h2>

        <form method="get" class="mb-4">
            <div class="input-group input-group-lg">
                <input type="text" class="form-control" name="q" value="@Model.SearchTerm"
                       placeholder="Essayez : ' OR '1'='1 ...">
                <button class="btn btn-success" type="submit">Rechercher</button>
            </div>
        </form>

        <!-- Code source -->
        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white">Code C# de cette page</div>
            <div class="card-body">
<pre class="mb-0"><code>public IActionResult FromSqlInterpolated(string? q)
{
    var pattern = $"%{q}%";

    // SECURISE : FromSqlInterpolated transforme {pattern} en parametre @@p0
    var results = _context.Persons
        .<span style="color:#2ed573">FromSqlInterpolated</span>(
            $"SELECT * FROM EfPersons WHERE LastName LIKE <span style="color:#2ed573">{pattern}</span> OR City LIKE <span style="color:#2ed573">{pattern}</span>"
        ).ToList();

    // EF genere :
    // SELECT * FROM EfPersons WHERE LastName LIKE <span style="color:#2ed573">@@p0</span> OR City LIKE <span style="color:#2ed573">@@p1</span>
    // avec @@p0 = "%valeur%" (PARAMETRE)
}</code></pre>
            </div>
        </div>

        <!-- SQL genere -->
        @if (Model.GeneratedSql != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">SQL genere par EF Core</div>
                <div class="card-body p-0">
                    <div class="sql-display m-3" style="color:#2ed573;">@Model.GeneratedSql</div>
                </div>
            </div>
        }

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger"><strong>Erreur :</strong> @Model.ErrorMessage</div>
        }

        @if (Model.Results.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header">Resultats (@Model.Results.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-results mb-0">
                            <thead><tr><th>ID</th><th>Nom</th><th>Email</th><th>Ville</th><th>Dept.</th></tr></thead>
                            <tbody>
                                @foreach (var p in Model.Results)
                                {
                                    <tr>
                                        <td>@p.Id</td>
                                        <td>@p.FirstName @p.LastName</td>
                                        <td>@p.Email</td>
                                        <td>@p.City</td>
                                        <td>@p.Department</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (Model.SearchTerm != null && Model.ErrorMessage == null)
        {
            <div class="alert alert-info">
                Aucun resultat. L'injection est traitee comme du texte litteral par le parametre SQL.
            </div>
        }

        <!-- Comparaison cote a cote -->
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark">Le piege : FromSqlRaw vs FromSqlInterpolated</div>
            <div class="card-body">
<pre class="mb-0"><code><span style="color:#5c6370">// Ces deux lignes SEMBLENT identiques visuellement :</span>

<span style="color:#ff4757">// 1. VULNERABLE - C# interpole la string AVANT de la passer a EF</span>
context.Persons.<span style="color:#ff4757">FromSqlRaw</span>($"SELECT * FROM P WHERE Name = '<span style="color:#ff4757">{input}</span>'");
<span style="color:#5c6370">//   Type du parametre : string (deja resolue par C#)</span>
<span style="color:#5c6370">//   EF recoit : "SELECT * FROM P WHERE Name = 'valeur_injectee'"</span>

<span style="color:#2ed573">// 2. SECURISE - EF intercepte le FormattableString AVANT interpolation</span>
context.Persons.<span style="color:#2ed573">FromSqlInterpolated</span>($"SELECT * FROM P WHERE Name = <span style="color:#2ed573">{input}</span>");
<span style="color:#5c6370">//   Type du parametre : FormattableString (EF extrait les {placeholders})</span>
<span style="color:#5c6370">//   EF genere : "SELECT * FROM P WHERE Name = @@p0" avec @@p0 = input</span></code></pre>
                <div class="alert alert-info mt-3 mb-0">
                    <strong>Regle simple</strong> :
                    Si vous devez ecrire du SQL brut dans EF, utilisez <strong>toujours</strong>
                    <code>FromSqlInterpolated</code>. Reservez <code>FromSqlRaw</code> uniquement
                    pour les requetes sans aucun input utilisateur (requetes statiques).
                </div>
            </div>
        </div>
    </div>
</div>
