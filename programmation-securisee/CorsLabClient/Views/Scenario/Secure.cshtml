@{
    ViewData["Title"] = "Scenario 4 - Securise";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-10">
        <h2><span class="badge bg-success">Scenario 4</span> Securise — Whitelist d'origines</h2>
        <p class="lead text-muted">
            L'API autorise uniquement <code>http://localhost:5301</code>.
            Toute autre origine est bloquee par le navigateur.
        </p>

        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white fw-bold">La bonne configuration</div>
            <div class="card-body">
                <p>La configuration serveur utilise :</p>
                <pre><code>policy.WithOrigins("http://localhost:5301")  <span class="text-success">// Seule cette origine</span>
      .AllowCredentials();                     <span class="text-success">// Cookies autorises</span></code></pre>
                <p>Resultat :</p>
                <ul>
                    <li>Les requetes depuis <code>http://localhost:5301</code> (cette app) fonctionnent</li>
                    <li>Les requetes depuis toute autre origine sont bloquees par le navigateur</li>
                    <li>Les cookies sont envoyes uniquement vers l'origine de confiance</li>
                </ul>
                <p class="mb-0 text-success"><strong>C'est la configuration recommandee pour les API privees.</strong></p>
            </div>
        </div>

        <!-- Etape 1 : Connexion -->
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark fw-bold">Etape 1 : Se connecter</div>
            <div class="card-body">
                <p>Connectez-vous pour obtenir le cookie de session.</p>
                <button class="btn btn-warning" id="btn-login-secure">Se connecter</button>
                <button class="btn btn-outline-secondary ms-2" id="btn-check-secure">Verifier le statut</button>
                <div id="result-auth-secure" class="mt-3"></div>
            </div>
        </div>

        <!-- Etape 2 : Requete autorisee -->
        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white fw-bold">Etape 2 : Requete depuis l'origine autorisee</div>
            <div class="card-body">
                <p>Cette requete part de <code>http://localhost:5301</code> — l'origine autorisee par le serveur.</p>
                <button class="btn btn-success" id="btn-secure-ok">Requete autorisee</button>
                <div id="result-secure-ok" class="mt-3"></div>
            </div>
        </div>

        <!-- Comparaison -->
        <div class="card border-dark mb-4">
            <div class="card-header bg-dark text-white fw-bold">Comparaison : Vulnerable vs Securise</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card border-danger h-100">
                            <div class="card-header bg-danger text-white fw-bold">Vulnerable</div>
                            <div class="card-body">
<pre><code class="text-danger">SetIsOriginAllowed(_ => true)
AllowCredentials()</code></pre>
                                <p class="mb-0 text-danger">Accepte toute origine → vol de donnees</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-success h-100">
                            <div class="card-header bg-success text-white fw-bold">Securise</div>
                            <div class="card-body">
<pre><code class="text-success">WithOrigins("http://localhost:5301")
AllowCredentials()</code></pre>
                                <p class="mb-0 text-success">Seule l'origine de confiance est acceptee</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-dark mb-4">
            <div class="card-header bg-dark text-white fw-bold">En-tetes HTTP</div>
            <div class="card-body">
                <pre><code>GET /api/secure/compte HTTP/1.1
Host: localhost:5300
Origin: http://localhost:5301
Cookie: session_banque=user_jean_dupont

HTTP/1.1 200 OK
Content-Type: application/json
<span class="text-success">Access-Control-Allow-Origin: http://localhost:5301</span>
<span class="text-success">Access-Control-Allow-Credentials: true</span>

{"nom":"Jean Dupont","iban":"BE68 5390 0754 7034","solde":12750.42}</code></pre>
            </div>
        </div>

        <div class="alert alert-success">
            <strong>Bonne pratique :</strong> Toujours utiliser <code>WithOrigins()</code> avec une liste explicite
            d'origines de confiance. Ne jamais utiliser <code>SetIsOriginAllowed(_ => true)</code> en production.
        </div>
    </div>
</div>

@section Scripts {
<script>
const API = 'http://localhost:5300';

document.getElementById('btn-login-secure').addEventListener('click', async () => {
    const resultDiv = document.getElementById('result-auth-secure');
    try {
        const response = await fetch(`${API}/api/auth/login`, {
            method: 'POST',
            credentials: 'include'
        });
        const data = await response.json();
        resultDiv.innerHTML = `<div class="alert alert-success"><strong>${data.message}</strong></div>`;
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger"><code>${error.message}</code></div>`;
    }
});

document.getElementById('btn-check-secure').addEventListener('click', async () => {
    const resultDiv = document.getElementById('result-auth-secure');
    try {
        const response = await fetch(`${API}/api/auth/status`, {
            credentials: 'include'
        });
        const data = await response.json();
        resultDiv.innerHTML = data.authenticated
            ? `<div class="alert alert-success">Connecte : <strong>${data.user}</strong></div>`
            : `<div class="alert alert-warning">Non connecte</div>`;
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger"><code>${error.message}</code></div>`;
    }
});

document.getElementById('btn-secure-ok').addEventListener('click', async () => {
    const resultDiv = document.getElementById('result-secure-ok');
    resultDiv.innerHTML = '<div class="text-muted">Envoi de la requete...</div>';
    try {
        const response = await fetch(`${API}/api/secure/compte`, {
            credentials: 'include'
        });
        const data = await response.json();
        if (data.error) {
            resultDiv.innerHTML = `<div class="alert alert-warning"><strong>${data.error}</strong> — Connectez-vous d'abord.</div>`;
        } else {
            resultDiv.innerHTML = `<div class="alert alert-success">
                <strong>Acces autorise !</strong> L'origine <code>http://localhost:5301</code> est dans la whitelist.<br>
                <table class="table table-sm table-bordered mt-2 mb-0">
                    <tr><th>Nom</th><td>${data.nom}</td></tr>
                    <tr><th>IBAN</th><td><code>${data.iban}</code></td></tr>
                    <tr><th>Solde</th><td><strong>${data.solde.toFixed(2)} ${data.devise}</strong></td></tr>
                </table>
            </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">
            <strong>Erreur CORS !</strong> L'origine n'est pas autorisee.<br>
            <code>${error.message}</code>
        </div>`;
    }
});
</script>
}
