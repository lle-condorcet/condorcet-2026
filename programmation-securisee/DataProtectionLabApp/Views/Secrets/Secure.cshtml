@model SecretsViewModel
@{
    ViewData["Title"] = "Secrets Secure";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-10">
        <h2 class="text-success fw-bold mb-3">User Secrets &amp; Variables d'environnement</h2>
        <p class="text-muted">
            Cette page montre comment securiser les secrets de configuration
            en utilisant <strong>User Secrets</strong> (developpement) et les <strong>variables d'environnement</strong> (production).
        </p>

        <div class="alert alert-success">
            <strong>SECURISE :</strong> Les secrets sont resolus par le systeme de configuration .NET.
            En developpement, ils proviennent de User Secrets (hors du code source).
        </div>

        <div class="card border-info mb-4">
            <div class="card-header bg-info text-white fw-bold">Hierarchie de configuration .NET</div>
            <div class="card-body">
                <p>Le systeme de configuration .NET charge les sources dans cet ordre (la derniere gagne) :</p>
                <ol>
                    <li><code>appsettings.json</code> — valeurs par defaut (pas de secrets !)</li>
                    <li><code>appsettings.{Environment}.json</code> — surcharges par environnement</li>
                    <li><strong class="text-success">User Secrets</strong> — secrets locaux au developpeur (Development uniquement)</li>
                    <li><strong class="text-primary">Variables d'environnement</strong> — secrets en production (Azure, Docker, CI/CD)</li>
                    <li>Arguments de ligne de commande</li>
                </ol>
            </div>
        </div>

        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white fw-bold">Secrets resolus (masques)</div>
            <div class="card-body">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Cle</th>
                            <th>Valeur masquee</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var secret in Model.MaskedSecrets)
                        {
                            <tr>
                                <td><code>@secret.Key</code></td>
                                <td><span class="text-success">@secret.Value</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white fw-bold">Commandes User Secrets</div>
            <div class="card-body">
                <p>Executez ces commandes dans le dossier du projet pour configurer les User Secrets :</p>
                @foreach (var cmd in Model.Commands)
                {
                    <pre><code>@cmd</code></pre>
                }
            </div>
        </div>

        <div class="card border-info mb-4">
            <div class="card-header bg-info text-white fw-bold">Ou sont stockes les User Secrets ?</div>
            <div class="card-body">
                <p>Les User Secrets sont stockes en dehors du projet, dans le profil utilisateur :</p>
                <pre><code>@Model.UserSecretsPath</code></pre>
                <p class="mb-0 text-muted">
                    Ce fichier n'est jamais commite dans Git. Il est specifique a chaque developpeur
                    et n'existe que sur sa machine.
                </p>
            </div>
        </div>

        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark fw-bold">En production : variables d'environnement</div>
            <div class="card-body">
                <p>En production, utilisez les variables d'environnement ou un service de secrets :</p>
                <pre><code># Linux / Docker
export ConnectionStrings__DefaultConnection="Server=prod;Database=ProdDB;..."
export ApiKeys__PaymentGateway="sk_live_real_key"

# Azure App Service
az webapp config appsettings set --name MyApp --settings ApiKeys__PaymentGateway="sk_live_real_key"

# Docker Compose
environment:
  - ConnectionStrings__DefaultConnection=Server=prod;Database=ProdDB;...</code></pre>
                <p class="mb-0 text-muted">
                    Notez l'utilisation de <code>__</code> (double underscore) comme separateur de sections
                    dans les variables d'environnement.
                </p>
            </div>
        </div>
    </div>
</div>
