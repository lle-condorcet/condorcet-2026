@model SecretsViewModel
@{
    ViewData["Title"] = "Secrets Vulnerable";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-10">
        <h2 class="text-danger fw-bold mb-3">Secrets en clair dans appsettings.json</h2>
        <p class="text-muted">
            Cette page montre les secrets lus directement depuis <code>appsettings.json</code>.
            Ce fichier est commite dans le depot Git et visible par tous les developpeurs.
        </p>

        <div class="alert alert-danger">
            <strong>DANGER :</strong> Les secrets ci-dessous sont lus depuis <code>@Model.ConfigSource</code>.
            En production, ces secrets seraient exposes a quiconque a acces au code source.
        </div>

        <div class="card border-danger mb-4">
            <div class="card-header bg-danger text-white fw-bold">Secrets exposes via IConfiguration</div>
            <div class="card-body">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Cle</th>
                            <th>Valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var secret in Model.ExposedSecrets)
                        {
                            <tr>
                                <td><code>@secret.Key</code></td>
                                <td><span class="text-danger fw-bold">@secret.Value</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.AppSettingsContent != null)
        {
            <div class="card border-danger mb-4">
                <div class="card-header bg-danger text-white fw-bold">Contenu brut de appsettings.json</div>
                <div class="card-body p-0">
                    <pre class="mb-0"><code>@Model.AppSettingsContent</code></pre>
                </div>
            </div>
        }

        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark fw-bold">Simulation : historique Git</div>
            <div class="card-body p-0">
                <pre class="mb-0"><code>$ git log --oneline --all
a1b2c3d feat: add payment gateway integration
f4e5d6a fix: update database connection string
b7c8d9e chore: add API keys for email and maps services
1a2b3c4 initial commit

$ git show a1b2c3d -- appsettings.json
+  "PaymentGateway": "sk_live_FAKE_4242424242424242"

$ git show f4e5d6a -- appsettings.json
-  "Password=OldPassword123"
+  "Password=SuperSecret123!"</code></pre>
            </div>
        </div>

        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark fw-bold">Risques identifies</div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><strong>Commit Git :</strong> Les secrets sont dans l'historique Git, meme apres suppression du fichier</li>
                    <li><strong>Exposition en production :</strong> Le fichier <code>appsettings.json</code> est deploye avec l'application</li>
                    <li><strong>Acces par d'autres developpeurs :</strong> Tout contributeur du projet peut voir les secrets</li>
                    <li><strong>Fuites accidentelles :</strong> Push sur un depot public, copie sur un poste non securise</li>
                    <li><strong>Pas de rotation :</strong> Changer un secret necessite un nouveau commit et deploiement</li>
                </ul>
            </div>
        </div>
    </div>
</div>
