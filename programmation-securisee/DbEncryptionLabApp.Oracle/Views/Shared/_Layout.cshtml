<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DB Encryption Lab (Oracle)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .encrypted-text {
            font-family: 'Courier New', monospace;
            font-size: 0.72rem;
            word-break: break-all;
            max-width: 220px;
            display: inline-block;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="text-warning">DB</span> Encryption Lab <small class="text-danger">(Oracle)</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-controller="ClearText" asp-action="Index">
                                En Clair
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success" asp-controller="ValueConverter" asp-action="Index">
                                Value Converter
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info" asp-controller="AesEncryption" asp-action="Index">
                                AES-256
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="AlwaysEncrypted" asp-action="Index">
                                TDE / DBMS_CRYPTO
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Comparison" asp-action="Index">
                                Comparaison
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center py-3">
            Condorcet 2026 - Programmation Securisee - Labo Chiffrement Base de Donnees (Oracle)
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
