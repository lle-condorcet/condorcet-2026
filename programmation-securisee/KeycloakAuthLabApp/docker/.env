# ──────────────────────────────────────
# Configuration du laboratoire Keycloak
# ──────────────────────────────────────

# PostgreSQL
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Application .NET
APP_PORT=5000
APP_CLIENT_SECRET=dev-secret-change-in-production

