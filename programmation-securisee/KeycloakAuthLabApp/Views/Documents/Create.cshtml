@model SecureDocument
@{
    ViewData["Title"] = "Nouveau document";
}

<h1>Nouveau <span class="accent">document</span></h1>
<p class="subtitle">Creer un document securise avec un niveau de classification.</p>

<div class="card" style="max-width: 600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Title">Titre</label>
            <input asp-for="Title" class="form-control" placeholder="Titre du document" required />
        </div>

        <div class="form-group">
            <label asp-for="Content">Contenu</label>
            <textarea asp-for="Content" class="form-control" placeholder="Contenu du document..." required></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Classification">Classification</label>
            <select asp-for="Classification" class="form-control" asp-items="Html.GetEnumSelectList<Classification>()"></select>
        </div>

        <div class="alert alert-warning">
            <strong>Rappel :</strong> Le niveau de classification determine qui peut acceder au document.
            Les utilisateurs avec un role insuffisant ne verront pas ce document.
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">Creer le document</button>
            <a href="/Documents" class="btn btn-primary" style="background: var(--surface-2);">Annuler</a>
        </div>
    </form>
</div>
